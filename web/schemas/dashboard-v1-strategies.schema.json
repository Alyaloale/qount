{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qount.alyaloale.com/schemas/dashboard-v1-strategies.schema.json",
  "title": "qount Dashboard v1 strategies",
  "allOf": [
    { "$ref": "dashboard-v1-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "read_model_type": { "const": "strategies" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "strategies"],
          "properties": {
            "authority": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/authority" },
            "strategies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["strategy_id", "strategy_version", "strategy_kind", "registry_status", "execution_status", "live_orders_allowed", "execution_blockers", "registry_entry_id", "strategy_contract_hash", "maximum_gross", "maximum_stress_loss_fraction", "promotion_evidence_present", "owner_authorization_present", "latest_decision", "nav"],
                "properties": {
                  "strategy_id": { "type": "string", "minLength": 1 },
                  "strategy_version": { "type": "string", "minLength": 1 },
                  "strategy_kind": { "enum": ["continuous", "event", "filter"] },
                  "registry_status": { "enum": ["draft", "research", "frozen_candidate", "shadow", "paper", "minimal_live", "scaled_live", "halted"] },
                  "execution_status": { "enum": ["disarmed", "blocked", "armed"] },
                  "live_orders_allowed": { "const": false },
                  "execution_blockers": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "registry_entry_id": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/hash" },
                  "strategy_contract_hash": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/hash" },
                  "maximum_gross": { "type": "number", "minimum": 0, "maximum": 1 },
                  "maximum_stress_loss_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                  "promotion_evidence_present": { "type": "boolean" },
                  "owner_authorization_present": { "type": "boolean" },
                  "latest_decision": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "required": ["decision_id", "intent_hash", "decision_time", "reason_codes", "standalone_target", "standalone_target_gross", "portfolio_sleeve", "target_stress_loss_fraction"],
                    "properties": {
                      "decision_id": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/hash" },
                      "intent_hash": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/hash" },
                      "decision_time": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/timestamp" },
                      "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
                      "standalone_target": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/weights" },
                      "standalone_target_gross": { "type": "number", "minimum": 0, "maximum": 1 },
                      "portfolio_sleeve": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/weights" },
                      "target_stress_loss_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  },
                  "nav": {
                    "oneOf": [
                      { "$ref": "dashboard-v1-envelope.schema.json#/$defs/ledger_unavailable" },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["status", "source", "values"],
                        "properties": {
                          "status": { "const": "available" },
                          "source": { "const": "runtime_ledger" },
                          "values": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["scope", "nav_mark_id", "mark_hash", "marked_at", "signal_nav", "standalone_executable_nav"],
                            "properties": {
                              "scope": { "const": "portfolio" },
                              "nav_mark_id": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/hash" },
                              "mark_hash": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/hash" },
                              "marked_at": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/timestamp" },
                              "signal_nav": { "type": ["number", "null"], "exclusiveMinimum": 0 },
                              "standalone_executable_nav": { "type": ["number", "null"], "exclusiveMinimum": 0 }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
