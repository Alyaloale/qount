{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qount.alyaloale.com/schemas/dashboard-v1-readiness.schema.json",
  "title": "qount Dashboard v1 readiness",
  "allOf": [
    { "$ref": "dashboard-v1-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "read_model_type": { "const": "readiness" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "status", "axes", "gates", "strategies"],
          "properties": {
            "authority": { "$ref": "dashboard-v1-envelope.schema.json#/$defs/authority" },
            "status": { "enum": ["blocked_phase_b_required", "blocked_runtime_state", "read_only_observation_ready", "read_model_ready", "stale"] },
            "axes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["publication_integrity", "observation_state", "operational_state", "trading_authority", "evidence_state"],
              "properties": {
                "publication_integrity": { "$ref": "#/$defs/axis" },
                "observation_state": { "$ref": "#/$defs/axis" },
                "operational_state": { "$ref": "#/$defs/axis" },
                "trading_authority": { "$ref": "#/$defs/axis" },
                "evidence_state": { "$ref": "#/$defs/axis" }
              }
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gate", "status", "detail"],
                "properties": {
                  "gate": { "type": "string", "minLength": 1 },
                  "status": { "enum": ["pass", "block", "unavailable"] },
                  "detail": { "type": "string", "minLength": 1 }
                }
              }
            },
            "strategies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["strategy_id", "strategy_version", "registry_status", "execution_status", "current_batch_decision_present", "promotion_evidence_present", "owner_authorization_present", "live_orders_allowed", "execution_blockers"],
                "properties": {
                  "strategy_id": { "type": "string", "minLength": 1 },
                  "strategy_version": { "type": "string", "minLength": 1 },
                  "registry_status": { "enum": ["draft", "research", "frozen_candidate", "shadow", "paper", "minimal_live", "scaled_live", "halted"] },
                  "execution_status": { "enum": ["disarmed", "blocked", "armed"] },
                  "current_batch_decision_present": { "type": "boolean" },
                  "promotion_evidence_present": { "type": "boolean" },
                  "owner_authorization_present": { "type": "boolean" },
                  "live_orders_allowed": { "const": false },
                  "execution_blockers": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail", "impact_scopes"],
      "properties": {
        "status": { "enum": ["pass", "fresh", "stale", "healthy", "degraded", "unavailable", "registry_authorized", "disarmed", "blocked", "armed", "complete", "incomplete"] },
        "detail": { "type": "string", "minLength": 1 },
        "impact_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["execution", "observation", "intelligence", "delivery"] }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
