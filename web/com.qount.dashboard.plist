<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job: push dashboard data (A股 CTA-R + X4 paper) to the VPS every 5 minutes.
     Install:
       cp web/com.qount.dashboard.plist ~/Library/LaunchAgents/
       launchctl load -w ~/Library/LaunchAgents/com.qount.dashboard.plist
     Logs: ~/Library/Logs/qount_dashboard.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qount.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alyaloale/Code/qount/web/push_dashboard.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/alyaloale/Library/Logs/qount_dashboard.log</string>
  <key>StandardErrorPath</key><string>/Users/alyaloale/Library/Logs/qount_dashboard.log</string>
</dict>
</plist>
