# Safe Mac-local template. Copy to private .env, populate only the variables
# you are authorized to use, then chmod 600 .env when it contains a secret.
# The contract is config/environment-contract.toml; do not add uncontracted keys.

QOUNT_MODE=paper
QOUNT_PROJECT_ROOT=
QOUNT_STATE_DIR=
QOUNT_EXCHANGE_ID=binance
QOUNT_MARKET_TYPE=spot
QOUNT_SYMBOLS=BTC/USDT,ETH/USDT
QOUNT_TIMEFRAME=1h
QOUNT_LOOKBACK_BARS=200
QOUNT_QUOTE_CURRENCY=USDT
QOUNT_PAPER_STARTING_QUOTE=200
QOUNT_RULE_MODE=strict

# Local relay placeholders only. Do not enter a production endpoint or token here.
QOUNT_OPENAI_BASE_URL=http://127.0.0.1:8318/v1
QOUNT_OPENAI_API_KEY=
QOUNT_AI_MODEL=
QOUNT_AI_TIMEOUT_SECONDS=40
QOUNT_AI_TEMPERATURE=0.2

# Optional research credentials: leave blank unless an approved local study needs them.
QOUNT_TIINGO_API_KEY=
QOUNT_ALPHA_AGENT_LLM_ENABLE=false
QOUNT_ALPHA_AGENT_API_KEY=

# Do not add live confirmations, arm tokens, broker credentials, proxy addresses,
# WSL topology paths or VPS service variables to this Mac-local template.
