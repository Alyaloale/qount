[Unit]
Description=Qount CTA-R public ETF research input collector
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/root/qount
ConditionPathIsDirectory=/var/lib/qount/research
ConditionPathExists=/root/qount/deploy/research/cta-r-akshare-sources.json

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/research/governance/run_forward_collector.py --repo-root /root/qount --source-config /root/qount/deploy/research/cta-r-akshare-sources.json --state-root /var/lib/qount/research/forward/cta-r-akshare-v1 --liquidation-state-root /var/lib/qount/research/liquidation-cascade-v1 --plugins research_lines --symbols BTCUSDT --min-free-disk-gb 8 --timeout-seconds 20
UMask=0077
Nice=10
CPUQuota=15%
MemoryHigh=128M
MemoryMax=256M
TasksMax=16
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qount/research/forward/cta-r-akshare-v1
ReadOnlyPaths=/var/lib/qount/research/cta-r
ReadOnlyPaths=/root/qount/deploy/research/cta-r-akshare-sources.json
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
