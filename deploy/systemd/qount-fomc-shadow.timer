[Unit]
Description=Observe the July 2026 FOMC window without order authority

[Timer]
OnCalendar=2026-07-29 17..23:0/5:00 UTC
OnCalendar=2026-07-30 00..10:0/5:00 UTC
OnCalendar=2026-07-30 11:00:00 UTC
# Retry only the public, order-free scorecard collection after force exit.
OnCalendar=2026-07-30 11:05:00 UTC
OnCalendar=2026-07-30 11:10:00 UTC
OnCalendar=2026-07-30 11:15:00 UTC
OnCalendar=2026-07-30 11:20:00 UTC
OnCalendar=2026-07-30 11:25:00 UTC
OnCalendar=2026-07-30 11:30:00 UTC
Persistent=true
RandomizedDelaySec=15s
AccuracySec=1s
Unit=qount-fomc-shadow.service

[Install]
WantedBy=timers.target
