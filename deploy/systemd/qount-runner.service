# LEGACY WSL / line A sample only.
# Current crypto live and paper production runs on the VPS via crontab and
# scripts/desktop/*_cron.sh. Do not install this service as the production
# scheduler unless the owner explicitly revives the old qount.main line.

[Unit]
Description=qount scheduled AI trading run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Code/qount
EnvironmentFile=%h/Code/qount/.env
ExecStart=%h/Code/qount/.venv/bin/python -m qount.main run-once
