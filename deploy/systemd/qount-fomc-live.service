[Unit]
Description=Qount bounded FOMC automatic execution and position-management cycle
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/qount/deploy/events/fomc-2026-07.json
ConditionPathExists=/root/qount/scripts/operations/run_fomc_live.py
ConditionPathIsDirectory=/var/lib/qount/fomc

[Service]
Type=oneshot
WorkingDirectory=/root/qount
EnvironmentFile=/root/qount/.env
EnvironmentFile=-/root/.config/qount/fomc-live.env
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QOUNT_MODE=live
Environment=QOUNT_MARKET_TYPE=future
Environment=QOUNT_EXCHANGE_ID=binance
Environment=QOUNT_EXCHANGE_BYPASS_PROXY=true
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_X4_LIVE_ENABLE=false
Environment=QOUNT_RV_LIVE_ENABLE=false
Environment=QOUNT_CXD_CARRY_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/operations/run_fomc_live.py --event-config /root/qount/deploy/events/fomc-2026-07.json --state-root /var/lib/qount/fomc auto-cycle
UMask=0077
Nice=5
CPUQuota=60%
MemoryHigh=384M
MemoryMax=512M
TasksMax=48
TimeoutStartSec=3m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qount/fomc
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
