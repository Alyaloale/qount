[Unit]
Description=Qount public ETF timing and frozen regime paper accounts, then refresh read-only research
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
UnsetEnvironment=BINANCE_API_KEY BINANCE_SECRET QOUNT_BINANCE_API_KEY QOUNT_BINANCE_API_SECRET QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/operations/run_research_paper.py --state-root /var/lib/qount/research/paper-forward-20261022 --registry /root/qount/config/paper-lines.json --db /var/lib/qount/api/candidates/assets-20261015T105250Z.db
UMask=0077
Nice=10
CPUQuota=25%
MemoryHigh=192M
MemoryMax=320M
TasksMax=24
TimeoutStartSec=4m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qount/research/paper-forward-20261022 /var/lib/qount/api
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
