[Unit]
Description=Run the bounded FOMC live path only during the July 2026 event window

[Timer]
OnCalendar=2026-07-29 17..23:*:00 UTC
OnCalendar=2026-07-30 00..10:*:00 UTC
OnCalendar=2026-07-30 11:00:00 UTC
Persistent=true
RandomizedDelaySec=5s
AccuracySec=1s
Unit=qount-fomc-live.service

[Install]
WantedBy=timers.target
