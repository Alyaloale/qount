[Unit]
Description=Qount MiniTrend order-free forward and paper cycle
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/qount/scripts/desktop/mini_trend_um_forward_cycle.sh
ConditionPathExists=!/root/qount/state/mini_trend/HALT

[Service]
Type=oneshot
WorkingDirectory=/root/qount
EnvironmentFile=/root/qount/.env
Environment=PYTHONPATH=/root/qount/src
Environment=QOUNT_PROJECT_ROOT=/root/qount
Environment=QOUNT_PYTHON_BIN=/root/qount/.venv/bin/python
Environment=QOUNT_MINI_TREND_STATE_ROOT=/root/qount/state/mini_trend
Environment=QOUNT_DASHBOARD_AUTHORITY_ROOT=/var/lib/qount/dashboard-authority
Environment=QOUNT_DASHBOARD_RUNTIME_ROOT=/var/lib/qount/dashboard-runtime
Environment=QOUNT_DASHBOARD_BACKUP_ROOT=/var/lib/qount/dashboard-backups
Environment=QOUNT_DASHBOARD_ROOT=/var/www/qount/data
Environment=QOUNT_DASHBOARD_LOCK_PATH=/run/qount-dashboard/publisher.lock
Environment=QOUNT_EXCHANGE_BYPASS_PROXY=true
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_LIVE_CONFIRMATION=
Environment=QOUNT_X4_LIVE_ENABLE=false
Environment=QOUNT_RV_LIVE_ENABLE=false
Environment=QOUNT_CXD_CARRY_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_CONFIRMATION=
UnsetEnvironment=QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN
ExecStart=/root/qount/scripts/desktop/mini_trend_um_forward_cycle.sh
RuntimeDirectory=qount-dashboard
RuntimeDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=80%
MemoryHigh=650M
MemoryMax=900M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/qount/state/mini_trend
ReadWritePaths=/var/lib/qount
ReadWritePaths=-/run/chrony
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=30m
