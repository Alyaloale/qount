[Unit]
Description=Qount read-only daily market intelligence and review
After=network-online.target openclaw-gateway.service
Wants=network-online.target openclaw-gateway.service
ConditionPathIsDirectory=/root/qount
ConditionPathIsDirectory=/var/lib/qount/dashboard-authority
ConditionPathIsDirectory=/var/lib/qount/intelligence
ConditionPathIsDirectory=/var/lib/qount/notifications
ConditionPathIsDirectory=/etc/qount/intelligence
ConditionPathIsDirectory=/root/.openclaw/openclaw-weixin/accounts
ConditionPathExists=/etc/qount/intelligence/relay-station.key
ConditionPathExists=/etc/qount/intelligence/openclaw-weixin.json

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_LIVE_CONFIRMATION=
Environment=QOUNT_X4_LIVE_ENABLE=false
Environment=QOUNT_RV_LIVE_ENABLE=false
Environment=QOUNT_CXD_CARRY_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_CONFIRMATION=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
UnsetEnvironment=QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN BINANCE_API_KEY BINANCE_SECRET QOUNT_BINANCE_API_KEY QOUNT_BINANCE_API_SECRET QOUNT_ALPHA_AGENT_API_KEY QOUNT_ALPHA_AGENT_BASE_URL QOUNT_ALPHA_AGENT_MODEL QOUNT_ALPHA_AGENT_PROVIDER_PROFILE QOUNT_ALPHA_AGENT_LLM_ENABLE QOUNT_ALPHA_AGENT_MAX_CONCURRENCY QOUNT_ALPHA_AGENT_MAX_RETRIES QOUNT_ALPHA_AGENT_RETRY_BASE_SECONDS QOUNT_ALPHA_AGENT_MAX_RETRY_DELAY_SECONDS
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/operations/run_daily_intelligence.py --authority-root /var/lib/qount/dashboard-authority --archive-root /var/lib/qount/intelligence --notification-store /var/lib/qount/notifications/store.sqlite3 --search-provider official-feeds --with-llm --llm-credential-path /etc/qount/intelligence/relay-station.key --llm-model gpt-5.6-sol --enqueue-personal-weixin --send-personal-weixin --personal-weixin-credential-path /etc/qount/intelligence/openclaw-weixin.json --personal-weixin-context-token-directory /root/.openclaw/openclaw-weixin/accounts
RuntimeDirectory=qount-intelligence
RuntimeDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=75%
MemoryHigh=384M
MemoryMax=512M
TasksMax=48
TimeoutStartSec=10m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=false
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/qount/dashboard-authority
ReadOnlyPaths=/etc/qount/intelligence
ReadOnlyPaths=/root/.openclaw/openclaw-weixin/accounts
ReadWritePaths=/var/lib/qount/intelligence
ReadWritePaths=/var/lib/qount/notifications
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
