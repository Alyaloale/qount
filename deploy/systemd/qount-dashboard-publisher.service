[Unit]
Description=Qount verified Dashboard v1 publisher
ConditionPathIsDirectory=/root/qount
ConditionPathIsDirectory=/var/lib/qount/dashboard-authority
ConditionPathIsDirectory=/var/www/qount/data
ConditionPathIsDirectory=/var/lib/qount/dashboard-backups

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_LIVE_CONFIRMATION=
Environment=QOUNT_X4_LIVE_ENABLE=false
Environment=QOUNT_RV_LIVE_ENABLE=false
Environment=QOUNT_CXD_CARRY_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_CONFIRMATION=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
UnsetEnvironment=QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN BINANCE_API_KEY BINANCE_SECRET
ExecStart=/root/qount/.venv/bin/python -m qount.operations.dashboard_publisher --authority-root /var/lib/qount/dashboard-authority --intelligence-root /var/lib/qount/intelligence --dashboard-root /var/www/qount/data --backup-root /var/lib/qount/dashboard-backups --lock-path /run/qount-dashboard/publisher.lock --disk-path /var/www/qount --service-name qount-dashboard-publisher.timer --retain-previous-releases 4 --retain-previous-backups 60
RuntimeDirectory=qount-dashboard
RuntimeDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=256M
MemoryMax=384M
TasksMax=32
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/var/lib/qount/intelligence
ReadWritePaths=/var/www/qount/data
ReadWritePaths=/var/lib/qount/dashboard-backups
ReadWritePaths=-/run/chrony
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
# chronyc needs DAC access to its 0700 runtime directory and client socket.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
