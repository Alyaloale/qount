# G20-LP v3 live authorization gates — authoritative override of /root/qount/.env.
# systemd reads EnvironmentFile= files in order and the later file wins; the shared
# /root/qount/.env ships QOUNT_LIVE_ENABLE=false (project default-off, 2026-07-19),
# which silently defeated this unit's Environment=QOUNT_LIVE_ENABLE=true and blocked
# the first live cycle with OrdersNotAuthorized on 2026-11-04 (fixed 2026-11-04).
# Installed at /etc/qount/g20-v3-live.env (0600 root).
QOUNT_LIVE_ENABLE=true
QOUNT_PRIMARY_STRATEGY=g20_leveraged_pool_v3
