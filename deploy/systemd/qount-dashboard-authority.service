[Unit]
Description=Qount order-free Dashboard authority writer
ConditionPathIsDirectory=/root/qount
ConditionPathExists=/root/qount/state/mini_trend/forward/latest
ConditionPathIsDirectory=/var/lib/qount/dashboard-authority
ConditionPathIsDirectory=/var/lib/qount/dashboard-backups
ConditionPathIsDirectory=/var/www/qount/data

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_LIVE_CONFIRMATION=
Environment=QOUNT_X4_LIVE_ENABLE=false
Environment=QOUNT_RV_LIVE_ENABLE=false
Environment=QOUNT_CXD_CARRY_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_CONFIRMATION=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
UnsetEnvironment=QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN BINANCE_API_KEY BINANCE_SECRET QOUNT_BINANCE_API_KEY QOUNT_BINANCE_API_SECRET
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/operations/write_authority_bundle.py --repo-root /root/qount --source-root /root/qount/state/mini_trend/forward/latest --authority-root /var/lib/qount/dashboard-authority --runtime-root /var/lib/qount/dashboard-runtime --backup-root /var/lib/qount/dashboard-backups --dashboard-root /var/www/qount/data --lock-path /run/qount-dashboard/publisher.lock --notification-store /var/lib/qount/notifications/store.sqlite3
SuccessExitStatus=75
RuntimeDirectory=qount-dashboard
RuntimeDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=256M
MemoryMax=384M
TasksMax=32
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qount
ReadWritePaths=-/run/chrony
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
# chronyc needs DAC access to its 0700 runtime directory and client socket.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
