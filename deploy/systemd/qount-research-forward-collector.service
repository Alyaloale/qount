[Unit]
Description=Qount unified public research forward evidence collector
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/root/qount
ConditionPathIsDirectory=/var/lib/qount/research
ConditionPathExists=/root/qount/deploy/research/forward-sources.json

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
EnvironmentFile=-/etc/qount/research-forward-collector.env
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
UnsetEnvironment=BINANCE_API_KEY BINANCE_SECRET BINANCE_SECRET_KEY QOUNT_BINANCE_API_KEY QOUNT_BINANCE_API_SECRET QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/research/governance/run_forward_collector.py --repo-root /root/qount --source-config /root/qount/deploy/research/forward-sources.json --state-root /var/lib/qount/research/forward --liquidation-state-root /var/lib/qount/research/liquidation-cascade-v1 --plugins research_lines --min-free-disk-gb 8 --timeout-seconds 20 --print-json
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryHigh=256M
MemoryMax=384M
TasksMax=32
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qount/research/forward
ReadOnlyPaths=/var/lib/qount/research/liquidation-cascade-v1
ReadOnlyPaths=/root/qount/deploy/research/forward-sources.json
ReadOnlyPaths=-/root/qount/state/cta_r/etf_source/etf_data.zip
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
