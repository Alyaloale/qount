[Unit]
Description=Qount FOMC public-data shadow watcher (orders impossible)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/qount/deploy/events/fomc-2026-07.json
ConditionPathIsDirectory=/var/lib/qount/fomc
ConditionPathIsDirectory=/var/lib/qount/notifications

[Service]
Type=oneshot
WorkingDirectory=/root/qount
Environment=PYTHONPATH=/root/qount/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QOUNT_MODE=shadow
Environment=QOUNT_MARKET_TYPE=future
Environment=QOUNT_EXCHANGE_ID=binance
Environment=QOUNT_EXCHANGE_BYPASS_PROXY=true
Environment=QOUNT_LIVE_ENABLE=false
Environment=QOUNT_X4_LIVE_ENABLE=false
Environment=QOUNT_RV_LIVE_ENABLE=false
Environment=QOUNT_CXD_CARRY_ENABLE=false
Environment=QOUNT_MINI_TREND_LIVE_ENABLE=false
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
UnsetEnvironment=QOUNT_LIVE_CONFIRMATION QOUNT_MINI_TREND_LIVE_CONFIRMATION QOUNT_MINI_TREND_ARM_TOKEN QOUNT_BINANCE_API_KEY QOUNT_BINANCE_API_SECRET QOUNT_TESTNET_API_KEY QOUNT_TESTNET_API_SECRET BINANCE_API_KEY BINANCE_SECRET
ExecStart=/root/qount/.venv/bin/python /root/qount/scripts/operations/run_fomc_shadow.py --event-config /root/qount/deploy/events/fomc-2026-07.json --state-root /var/lib/qount/fomc --notification-store /var/lib/qount/notifications/store.sqlite3
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=40%
MemoryHigh=256M
MemoryMax=384M
TasksMax=32
TimeoutStartSec=2m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/qount/fomc
ReadWritePaths=/var/lib/qount/notifications
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
